/-
# Sanity checks on the statement (non-vacuity tests)

Every check below is fully proved. These check that the definitions in `Statement.lean` are neither
empty nor trivially true:
* the EU class (hence the betweenness class) is nonempty;
* the constant preference is excluded;
* a concrete 2-point rule satisfies Chord Dominance and Bracketing and is a 1-term mixture;
* a concrete 3-point rule (uniform choice) violates Bracketing.
-/
import REU.Statement

namespace REU.Sanity

open REU

/-! ## Basic geometric examples -/

theorem sanity_NE : NE ((1/2, 1/2) : Pt) (1/4, 1/4) := by
  unfold NE; norm_num

theorem sanity_strictFOSD : StrictFOSD ((0, 1) : Pt) (1, 0) := by
  refine ⟨?_, ?_⟩
  · unfold FOSD; norm_num
  · simp [Prod.ext_iff]

/-! ## The linear EU preference `U(u,v) = v - u` -/

/-- Weak preference induced by `U(u, v) = v - u`. -/
def Rlin : Rel := fun q r => q.2 - q.1 ≥ r.2 - r.1

lemma U_mix (t : ℝ) (q r : Pt) :
    (mix t q r).2 - (mix t q r).1 = t * (q.2 - q.1) + (1 - t) * (r.2 - r.1) := by
  simp only [mix, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
  ring

lemma Rlin_iff (q r : Pt) : Rlin q r ↔ r.2 - r.1 ≤ q.2 - q.1 := Iff.rfl

lemma SPref_Rlin (q r : Pt) : SPref Rlin q r ↔ r.2 - r.1 < q.2 - q.1 := by
  simp only [SPref, Rlin_iff, not_le]
  constructor
  · exact fun h => h.2
  · exact fun h => ⟨h.le, h⟩

lemma isBetweenness_Rlin : IsBetweennessPref Rlin where
  complete q _ r _ := le_total _ _
  trans q _ r _ s _ h1 h2 := le_trans h2 h1
  closed_upper r _ := by
    have hc : Continuous fun q : Tri => (q : Pt).2 - (q : Pt).1 := by fun_prop
    exact isClosed_le continuous_const hc
  closed_lower r _ := by
    have hc : Continuous fun q : Tri => (q : Pt).2 - (q : Pt).1 := by fun_prop
    exact isClosed_le hc continuous_const
  strictMono q _ r _ h := by
    obtain ⟨⟨h1, h2⟩, hne⟩ := h
    rw [SPref_Rlin]
    by_contra hle
    apply hne
    exact Prod.ext (by linarith) (by linarith)
  btw_strict q _ r _ t ht h := by
    rw [SPref_Rlin] at h
    obtain ⟨ht0, ht1⟩ := ht
    rw [SPref_Rlin, SPref_Rlin, U_mix]
    have h1 : 0 < (1 - t) * ((q.2 - q.1) - (r.2 - r.1)) := mul_pos (by linarith) (by linarith)
    have h2 : 0 < t * ((q.2 - q.1) - (r.2 - r.1)) := mul_pos ht0 (by linarith)
    constructor <;> nlinarith
  btw_indiff q _ r _ t _ h := by
    obtain ⟨h1, h2⟩ := h
    simp only [Indiff, Rlin_iff, U_mix]
    have : q.2 - q.1 = r.2 - r.1 := le_antisymm h2 h1
    rw [← this]
    constructor <;> nlinarith

/-- Non-vacuity of both classes: `U(u,v) = v - u` is an EU (hence betweenness) preference. -/
lemma isEU_Rlin : IsEUPref Rlin := by
  refine ⟨isBetweenness_Rlin, ?_⟩
  intro q _ r _ s _ t ht
  obtain ⟨ht0, _⟩ := ht
  rw [Rlin_iff, Rlin_iff, U_mix, U_mix]
  constructor
  · intro h; nlinarith
  · intro h
    have : t * ((r.2 - r.1) - (q.2 - q.1)) ≤ 0 := by nlinarith
    by_contra hc
    push Not at hc
    have : 0 < t * ((r.2 - r.1) - (q.2 - q.1)) := mul_pos ht0 (by linarith)
    linarith

theorem sanity_EU_nonempty : IsEUPref (fun q r => q.2 - q.1 ≥ r.2 - r.1) := isEU_Rlin

theorem sanity_btw_nonempty : IsBetweennessPref (fun q r => q.2 - q.1 ≥ r.2 - r.1) := isEU_Rlin.1

/-! ## The constant (total indifference) relation is excluded -/

theorem sanity_const_excluded : ¬ IsBetweennessPref (fun _ _ => True) := by
  intro h
  have hq : ((0, 1) : Pt) ∈ Tri := by unfold Tri; norm_num
  have hr : ((1, 0) : Pt) ∈ Tri := by unfold Tri; norm_num
  have hs : StrictFOSD ((0, 1) : Pt) (1, 0) := by
    refine ⟨?_, ?_⟩
    · unfold FOSD; norm_num
    · simp [Prod.ext_iff]
  exact (h.strictMono _ hq _ hr hs).2 trivial

/-! ## Helper lemmas about `minOr1` -/

lemma minOr1_of_forall_one (S : Finset Pt) (g : Pt → ℝ) (h : ∀ y ∈ S, g y = 1) :
    minOr1 S g = 1 := by
  unfold minOr1
  split_ifs with hS
  · apply le_antisymm
    · obtain ⟨y, hy⟩ := hS
      exact (Finset.inf'_le g hy).trans (h y hy).le
    · exact Finset.le_inf' hS g (fun y hy => (h y hy).ge)
  · rfl

lemma minOr1_of_forall_eq (S : Finset Pt) (g : Pt → ℝ) (c : ℝ) (hS : S.Nonempty)
    (h : ∀ y ∈ S, g y = c) : minOr1 S g = c := by
  unfold minOr1
  rw [dite_eq_left hS]
  apply le_antisymm
  · obtain ⟨y, hy⟩ := hS
    exact (Finset.inf'_le g hy).trans (h y hy).le
  · exact Finset.le_inf' hS g (fun y hy => (h y hy).ge)

lemma minOr1_of_zero (S : Finset Pt) (g : Pt → ℝ) (y₀ : Pt) (hy₀ : y₀ ∈ S) (h0 : g y₀ = 0)
    (hnn : ∀ y ∈ S, 0 ≤ g y) : minOr1 S g = 0 := by
  unfold minOr1
  rw [dite_eq_left ⟨y₀, hy₀⟩]
  apply le_antisymm
  · exact (Finset.inf'_le g hy₀).trans h0.le
  · exact Finset.le_inf' _ g hnn

/-! ## A concrete 2-point X: the rule generated by `Rlin` -/

/-- `a = (1/4, 1/2)`: strictly NE of `b`, with `U(a) = 1/4`. -/
noncomputable def ptA : Pt := (1/4, 1/2)
/-- `b = (0, 0)`: the middle-prize vertex, `U(b) = 0`. -/
noncomputable def ptB : Pt := (0, 0)

/-- `X₂ = {a, b}`. -/
noncomputable def X₂ : Finset Pt := {ptA, ptB}

lemma hAB : ptA ≠ ptB := by simp [ptA, ptB, Prod.ext_iff]

lemma mem_X₂ {x : Pt} : x ∈ X₂ ↔ x = ptA ∨ x = ptB := by simp [X₂]

lemma X₂_subset_Tri : (↑X₂ : Set Pt) ⊆ Tri := by
  intro x hx
  rcases mem_X₂.1 hx with rfl | rfl <;> (simp only [Tri, ptA, ptB, Set.mem_ofPred_eq]; norm_num)

lemma NE_AB : NE ptA ptB := by unfold NE ptA ptB; norm_num

open Classical in
/-- The rule generated by `Rlin` on `X₂`: `a` (higher `U`) is chosen whenever available. -/
noncomputable def ρ₂ : RandomChoiceRule X₂ where
  p x A := if x ∈ A ∧ (x = ptA ∨ ptA ∉ A) then 1 else 0
  nonneg A _ x := by split_ifs <;> norm_num
  zero_of_not_mem A _ x hx := by rw [ite_eq_right (fun h => hx h.1)]
  sum_one A hA hne := by
    by_cases ha : ptA ∈ A
    · rw [Finset.sum_congr rfl (g := fun x => if ptA = x then (1 : ℝ) else 0)]
      · rw [Finset.sum_ite_eq, ite_eq_left ha]
      · intro x hx
        by_cases hxa : x = ptA
        · subst hxa; simp [ha]
        · rw [ite_eq_right (by tauto), ite_eq_right (Ne.symm hxa)]
    · have hAb : A = {ptB} := by
        obtain ⟨y, hy⟩ := hne
        ext z
        simp only [Finset.mem_singleton]
        constructor
        · intro hz
          rcases mem_X₂.1 (hA hz) with rfl | rfl
          · exact absurd hz ha
          · rfl
        · rintro rfl
          rcases mem_X₂.1 (hA hy) with rfl | rfl
          · exact absurd hy ha
          · exact hy
      subst hAb
      rw [Finset.sum_singleton, ite_eq_left ⟨Finset.mem_singleton_self _, Or.inr ha⟩]

lemma ρ₂_p (x : Pt) (A : Finset Pt) :
    ρ₂.p x A = if x ∈ A ∧ (x = ptA ∨ ptA ∉ A) then 1 else 0 := by
  unfold ρ₂; congr

/-- `ρ₂` really is the rule generated by the single EU preference `Rlin`. -/
lemma ρ₂_isMixture : IsMixture IsEUPref X₂ ρ₂ := by
  refine ⟨1, fun _ => Rlin, fun _ => 1, ?_, ?_, ?_, ?_⟩
  · intro _
    refine ⟨isEU_Rlin, ?_⟩
    intro x hx y hy hxy h
    have h' : y.2 - y.1 = x.2 - x.1 := le_antisymm h.1 h.2
    rcases mem_X₂.1 hx with rfl | rfl <;> rcases mem_X₂.1 hy with rfl | rfl <;>
      simp_all [ptA, ptB] <;> norm_num at h'
  · intro _; norm_num
  · simp
  · intro A hA _ x hx
    simp only [Finset.univ_unique, Finset.sum_singleton, ρ₂_p]
    have key : IsMaxIn Rlin x A ↔ (x ∈ A ∧ (x = ptA ∨ ptA ∉ A)) := by
      constructor
      · rintro ⟨hxA, hmax⟩
        refine ⟨hxA, ?_⟩
        by_contra hc
        push Not at hc
        have := (SPref_Rlin _ _).1 (hmax ptA hc.2 (Ne.symm hc.1))
        rcases mem_X₂.1 (hA hxA) with h | h
        · exact hc.1 h
        · subst h; unfold ptA ptB at this; norm_num at this
      · rintro ⟨hxA, hx'⟩
        refine ⟨hxA, fun y hy hyx => ?_⟩
        rw [SPref_Rlin]
        rcases mem_X₂.1 (hA hxA) with rfl | rfl <;> rcases mem_X₂.1 (hA hy) with rfl | rfl
        · exact absurd rfl hyx
        · unfold ptA ptB; norm_num
        · rcases hx' with h | h
          · exact absurd h.symm hAB
          · exact absurd hy h
        · exact absurd rfl hyx
    by_cases h : x ∈ A ∧ (x = ptA ∨ ptA ∉ A)
    · rw [ite_eq_left h, ite_eq_left (key.2 h)]
    · rw [ite_eq_right h, ite_eq_right (fun h' => h (key.1 h'))]

lemma isChord_X₂ {a b : Pt} (h : IsChord X₂ a b) : a = ptA ∧ b = ptB := by
  obtain ⟨ha, hb, hne⟩ := h
  rcases mem_X₂.1 ha with rfl | rfl <;> rcases mem_X₂.1 hb with rfl | rfl
  · exact absurd hne.1 (lt_irrefl _)
  · exact ⟨rfl, rfl⟩
  · unfold NE ptA ptB at hne; norm_num at hne
  · exact absurd hne.1 (lt_irrefl _)

/-- Chord Dominance and Bracketing hold for `ρ₂` (the conditions are satisfiable). -/
theorem sanity_X2_CD_B : ChordDominance X₂ ρ₂ ∧ Bracketing X₂ ρ₂ := by
  refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
  · -- CD-dom: no strict FOSD pair in X₂
    intro q hq r hr h
    obtain ⟨⟨h1, h2⟩, hne⟩ := h
    rcases mem_X₂.1 hq with rfl | rfl <;> rcases mem_X₂.1 hr with rfl | rfl
    · exact absurd rfl hne
    · unfold ptA ptB at h1; norm_num at h1
    · unfold ptA ptB at h2; norm_num at h2
    · exact absurd rfl hne
  · -- CD-cross: the only chord is (a, b)
    intro a b c d hab hcd _ hs
    obtain ⟨rfl, rfl⟩ := isChord_X₂ hab
    obtain ⟨rfl, rfl⟩ := isChord_X₂ hcd
    exact absurd hs (lt_irrefl _)
  · -- CD-col
    intro a b c d hab hcd _
    obtain ⟨rfl, rfl⟩ := isChord_X₂ hab
    obtain ⟨rfl, rfl⟩ := isChord_X₂ hcd
    rfl
  · -- Bracketing
    intro A hA x hx
    simp only [ρ₂_p]
    rcases mem_X₂.1 (hA hx) with rfl | rfl
    · -- x = a: nothing is NE of a; SW part has value 1
      have hSW : minOr1 (ASW A ptA)
          (fun b => if ptA ∈ ({ptA, b} : Finset Pt) ∧ (ptA = ptA ∨ ptA ∉ ({ptA, b} : Finset Pt))
            then (1 : ℝ) else 0) = 1 :=
        minOr1_of_forall_one _ _ (fun y _ => by simp)
      have hNE : minOr1 (ANE A ptA)
          (fun a => if ptA ∈ ({ptA, a} : Finset Pt) ∧ (ptA = ptA ∨ ptA ∉ ({ptA, a} : Finset Pt))
            then (1 : ℝ) else 0) = 1 :=
        minOr1_of_forall_one _ _ (fun y _ => by simp)
      rw [hSW, hNE, ite_eq_left ⟨hx, Or.inl rfl⟩]
      norm_num
    · by_cases ha : ptA ∈ A
      · -- x = b, a ∈ A: a is NE of b and beats it
        have hSW : minOr1 (ASW A ptB)
            (fun b => if ptB ∈ ({ptB, b} : Finset Pt) ∧
              (ptB = ptA ∨ ptA ∉ ({ptB, b} : Finset Pt)) then (1 : ℝ) else 0) = 1 := by
          apply minOr1_of_forall_one
          intro y hy
          simp only [ASW, Finset.mem_filter] at hy
          obtain ⟨hyA, hyb, hy'⟩ := hy
          rcases mem_X₂.1 (hA hyA) with rfl | rfl
          · exact absurd (Or.inl NE_AB) hy'
          · exact absurd rfl hyb
        have hNE : minOr1 (ANE A ptB)
            (fun a => if ptB ∈ ({ptB, a} : Finset Pt) ∧
              (ptB = ptA ∨ ptA ∉ ({ptB, a} : Finset Pt)) then (1 : ℝ) else 0) = 0 := by
          apply minOr1_of_zero _ _ ptA
          · simp only [ANE, Finset.mem_filter]
            exact ⟨ha, hAB, Or.inl NE_AB⟩
          · rw [ite_eq_right]
            rintro ⟨_, h | h⟩
            · exact hAB h.symm
            · exact h (by simp)
          · intro y _; split_ifs <;> norm_num
        rw [hSW, hNE, ite_eq_right]
        · norm_num
        · rintro ⟨_, h | h⟩
          · exact hAB h.symm
          · exact h ha
      · -- x = b, a ∉ A: menu {b}
        have hSW : minOr1 (ASW A ptB)
            (fun b => if ptB ∈ ({ptB, b} : Finset Pt) ∧
              (ptB = ptA ∨ ptA ∉ ({ptB, b} : Finset Pt)) then (1 : ℝ) else 0) = 1 := by
          apply minOr1_of_forall_one
          intro y hy
          simp only [ASW, Finset.mem_filter] at hy
          obtain ⟨hyA, hyb, _⟩ := hy
          rcases mem_X₂.1 (hA hyA) with rfl | rfl
          · exact absurd hyA ha
          · exact absurd rfl hyb
        have hNE : minOr1 (ANE A ptB)
            (fun a => if ptB ∈ ({ptB, a} : Finset Pt) ∧
              (ptB = ptA ∨ ptA ∉ ({ptB, a} : Finset Pt)) then (1 : ℝ) else 0) = 1 := by
          apply minOr1_of_forall_one
          intro y hy
          simp only [ANE, Finset.mem_filter] at hy
          obtain ⟨hyA, hyb, _⟩ := hy
          rcases mem_X₂.1 (hA hyA) with rfl | rfl
          · exact absurd hyA ha
          · exact absurd rfl hyb
        rw [hSW, hNE, ite_eq_left ⟨hx, Or.inr ha⟩]
        norm_num

/-! ## A concrete 3-point rule violating Bracketing: uniform choice -/

noncomputable def c₀ : Pt := (0, 0)
noncomputable def c₁ : Pt := (1/4, 1/4)
noncomputable def c₂ : Pt := (1/2, 1/2)

/-- `X₃ = {c₀, c₁, c₂}` (three collinear points, each NE of the previous; all in `Tri`). -/
noncomputable def X₃ : Finset Pt := {c₀, c₁, c₂}

lemma X₃_subset_Tri : (↑X₃ : Set Pt) ⊆ Tri := by
  intro x hx
  simp only [X₃, Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
    Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl <;> (simp only [Tri, c₀, c₁, c₂, Set.mem_ofPred_eq]; norm_num)

open Classical in
/-- Uniform random choice: every element of a menu is chosen with probability `1/|A|`.
A valid random choice rule (on any finite `X`). -/
noncomputable def uniformRule (X : Finset Pt) : RandomChoiceRule X where
  p x A := if x ∈ A then 1 / (A.card : ℝ) else 0
  nonneg A _ x := by split_ifs <;> positivity
  zero_of_not_mem A _ x hx := by rw [ite_eq_right hx]
  sum_one A _ hne := by
    rw [Finset.sum_congr rfl (g := fun _ => 1 / (A.card : ℝ)) (fun x hx => ite_eq_left hx),
      Finset.sum_const, nsmul_eq_mul]
    have : (A.card : ℝ) ≠ 0 := by exact_mod_cast (Finset.card_pos.2 hne).ne'
    field_simp

lemma uniformRule_p (X : Finset Pt) (x : Pt) (A : Finset Pt) :
    (uniformRule X).p x A = if x ∈ A then 1 / (A.card : ℝ) else 0 := by
  unfold uniformRule; congr

/-- Bracketing is not trivially true: uniform choice on `X₃` violates it at `x = c₀`,
`A = X₃` (formula gives `1/2`, rule gives `1/3`). -/
theorem sanity_X3_not_B : ¬ Bracketing X₃ (uniformRule X₃) := by
  intro hB
  have h01 : c₀ ≠ c₁ := by simp [c₀, c₁, Prod.ext_iff]
  have h02 : c₀ ≠ c₂ := by simp [c₀, c₂, Prod.ext_iff]
  have h12 : c₁ ≠ c₂ := by simp [c₁, c₂, Prod.ext_iff]
  have hcard : X₃.card = 3 := by
    simp [X₃, Finset.card_insert_of_notMem, h01, h02, h12]
  have hNE1 : NE c₁ c₀ := by unfold NE c₀ c₁; norm_num
  have hNE2 : NE c₂ c₀ := by unfold NE c₀ c₂; norm_num
  have hmem : ∀ y, y ∈ X₃ ↔ y = c₀ ∨ y = c₁ ∨ y = c₂ := by intro y; simp [X₃]
  have h := hB X₃ (subset_refl _) c₀ ((hmem c₀).2 (Or.inl rfl))
  simp only [uniformRule_p] at h
  have hSW : minOr1 (ASW X₃ c₀)
      (fun b => if c₀ ∈ ({c₀, b} : Finset Pt) then 1 / (({c₀, b} : Finset Pt).card : ℝ)
        else 0) = 1 := by
    apply minOr1_of_forall_one
    intro y hy
    simp only [ASW, Finset.mem_filter] at hy
    obtain ⟨hyX, hy0, hy'⟩ := hy
    rcases (hmem y).1 hyX with rfl | rfl | rfl
    · exact absurd rfl hy0
    · exact absurd (Or.inl hNE1) hy'
    · exact absurd (Or.inl hNE2) hy'
  have hNE : minOr1 (ANE X₃ c₀)
      (fun a => if c₀ ∈ ({c₀, a} : Finset Pt) then 1 / (({c₀, a} : Finset Pt).card : ℝ)
        else 0) = 1/2 := by
    apply minOr1_of_forall_eq _ _ _ ⟨c₁, ?_⟩
    · intro y hy
      simp only [ANE, Finset.mem_filter] at hy
      obtain ⟨_, hy0, _⟩ := hy
      rw [ite_eq_left (Finset.mem_insert_self _ _), Finset.card_pair (Ne.symm hy0)]
      norm_num
    · simp only [ANE, Finset.mem_filter]
      exact ⟨(hmem c₁).2 (Or.inr (Or.inl rfl)), Ne.symm h01, Or.inl hNE1⟩
  rw [hSW, hNE, ite_eq_left ((hmem c₀).2 (Or.inl rfl)), hcard] at h
  norm_num at h

/-! ## CD-cross is satisfiable and has content -/

/-- The hypothesis of CD-cross is satisfiable: two chords with different slopes whose lines
meet in the closed triangle (here at the vertex `(0,0)`). -/
theorem sanity_linesMeet :
    ∃ a b c d : Pt, NE a b ∧ NE c d ∧ slope c d < slope a b ∧ linesMeetInTri a b c d := by
  refine ⟨(1/2, 1/2), (1/4, 1/4), (2/3, 1/3), (1/3, 1/6), ?_, ?_, ?_, (0, 0), ?_, ?_, ?_⟩
  · unfold NE; norm_num
  · unfold NE; norm_num
  · unfold slope; norm_num
  · unfold Tri; norm_num
  · unfold OnLine; norm_num
  · unfold OnLine; norm_num

/-- Positive weights (Luce) for a rule that reverses the slope order. -/
def wt (x : Pt) : ℝ := 1 + 9 * x.1 ^ 2

lemma wt_pos (x : Pt) : 0 < wt x := by unfold wt; positivity

open Classical in
/-- Luce rule: `p(x, A) = w(x) / Σ_{y ∈ A} w(y)`. -/
noncomputable def luce (X : Finset Pt) : RandomChoiceRule X where
  p x A := if x ∈ A then wt x / ∑ y ∈ A, wt y else 0
  nonneg A _ x := by
    split_ifs
    · exact div_nonneg (wt_pos x).le (Finset.sum_nonneg fun y _ => (wt_pos y).le)
    · exact le_rfl
  zero_of_not_mem A _ x hx := by rw [ite_eq_right hx]
  sum_one A _ hne := by
    have hS : 0 < ∑ y ∈ A, wt y := Finset.sum_pos (fun y _ => wt_pos y) hne
    rw [Finset.sum_congr rfl (g := fun x => wt x / ∑ y ∈ A, wt y) (fun x hx => ite_eq_left hx),
      ← Finset.sum_div]
    exact div_self hS.ne'

lemma luce_p (X : Finset Pt) (x : Pt) (A : Finset Pt) :
    (luce X).p x A = if x ∈ A then wt x / ∑ y ∈ A, wt y else 0 := by
  unfold luce; congr

/-- Four points; chords `(pa, pb)` of slope 1 and `(pc, pd)` of slope 1/2 lie on lines
`v = u` and `v = u/2`, which cross at the vertex `(0,0)` of the triangle. -/
noncomputable def pa : Pt := (1/2, 1/2)
noncomputable def pb : Pt := (1/4, 1/4)
noncomputable def pc : Pt := (2/3, 1/3)
noncomputable def pd : Pt := (1/3, 1/6)

noncomputable def Xc : Finset Pt := {pa, pb, pc, pd}

/-- CD-cross has content: the Luce rule on four points, where the shallower chord is chosen
*more* often at its NE end (5/7 > 52/77) although the lines cross in `Tri`, violates
Chord Dominance. -/
theorem sanity_cross_violated : ¬ ChordDominance Xc (luce Xc) := by
  rintro ⟨_, hcross, _⟩
  have hab : pa ≠ pb := by simp [pa, pb, Prod.ext_iff]
  have hcd : pc ≠ pd := by simp [pc, pd, Prod.ext_iff]
  have h := hcross pa pb pc pd
    ⟨by simp [Xc], by simp [Xc], by unfold NE pa pb; norm_num⟩
    ⟨by simp [Xc], by simp [Xc], by unfold NE pc pd; norm_num⟩
    ⟨(0, 0), by unfold Tri; norm_num, by unfold OnLine pa pb; norm_num,
      by unfold OnLine pc pd; norm_num⟩
    (by unfold slope pa pb pc pd; norm_num)
  unfold fChord at h
  rw [luce_p, luce_p, ite_eq_left (by simp), ite_eq_left (by simp), Finset.sum_pair hab,
    Finset.sum_pair hcd] at h
  unfold wt pa pb pc pd at h
  norm_num at h

end REU.Sanity
