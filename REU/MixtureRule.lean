/-
# From pair values to a mixture

For a finite family of betweenness preferences `Rs i`, each strict on `X ⊆ Tri`, with weights
`w`, the formula `p x A = Σ_i w_i [x is the Rs i-max of A]` is a random choice rule
(`mixtureRule`), because every menu has exactly one `Rs i`-max (`exists_isMaxIn`,
`isMaxIn_unique`). Bracketing pins every menu value down from the pair values
(`bracketing_determines`), so a rule satisfying CD-dom and Bracketing whose chord values agree with
those of a mixture IS that mixture (`isMixture_of_chords`, for any class `C` of betweenness
preferences and any finite index type).
-/
import REU.Necessity

namespace REU

variable {R : Rel}

/-! ## Unique maxima -/

lemma spref_trans (hR : IsBetweennessPref R) {a b c : Pt} (ha : a ∈ Tri) (hb : b ∈ Tri)
    (hc : c ∈ Tri) (h1 : SPref R a b) (h2 : SPref R b c) : SPref R a c :=
  ⟨hR.trans a ha b hb c hc h1.1 h2.1, fun h => h2.2 (hR.trans c hc a ha b hb h h1.1)⟩

lemma isMaxIn_unique {A : Finset Pt} {x y : Pt} (hx : IsMaxIn R x A) (hy : IsMaxIn R y A) :
    x = y := by
  by_contra hne
  exact (hx.2 y hy.1 (Ne.symm hne)).2 (hy.2 x hx.1 hne).1

/-- Every menu has an `R`-max when `R` is a betweenness preference strict on `X`. -/
theorem exists_isMaxIn (hR : IsBetweennessPref R) {X : Finset Pt} (hX : (↑X : Set Pt) ⊆ Tri)
    (hS : StrictOn R X) {A : Finset Pt} (hA : A ⊆ X) (hne : A.Nonempty) :
    ∃ x, IsMaxIn R x A := by
  classical
  induction A using Finset.induction_on with
  | empty => exact absurd hne Finset.not_nonempty_empty
  | insert a s has ih =>
    have haX : a ∈ X := hA (Finset.mem_insert_self a s)
    have hsX : s ⊆ X := (Finset.subset_insert a s).trans hA
    rcases s.eq_empty_or_nonempty with rfl | hs
    · refine ⟨a, Finset.mem_insert_self a ∅, fun y hy hya => ?_⟩
      rcases Finset.mem_insert.1 hy with hy | hy
      · exact absurd hy hya
      · exact absurd hy (Finset.notMem_empty y)
    · obtain ⟨m, hmA, hm⟩ := ih hsX hs
      have hmX := hsX hmA
      have ham : a ≠ m := fun h => has (h ▸ hmA)
      have haT := hX haX
      have hmT := hX hmX
      rcases hR.complete a haT m hmT with h | h
      · have hsp : SPref R a m := ⟨h, fun h' => hS a haX m hmX ham ⟨h, h'⟩⟩
        refine ⟨a, Finset.mem_insert_self a s, fun y hy hya => ?_⟩
        rcases Finset.mem_insert.1 hy with hy | hy
        · exact absurd hy hya
        · by_cases hym : y = m
          · rw [hym]; exact hsp
          · exact spref_trans hR haT hmT (hX (hsX hy)) hsp (hm y hy hym)
      · have hsp : SPref R m a := ⟨h, fun h' => hS a haX m hmX ham ⟨h', h⟩⟩
        refine ⟨m, Finset.mem_insert_of_mem hmA, fun y hy hym => ?_⟩
        rcases Finset.mem_insert.1 hy with hy | hy
        · rw [hy]; exact hsp
        · exact hm y hy hym

theorem exists_unique_max (hR : IsBetweennessPref R) {X : Finset Pt} (hX : (↑X : Set Pt) ⊆ Tri)
    (hS : StrictOn R X) {A : Finset Pt} (hA : A ⊆ X) (hne : A.Nonempty) :
    ∃! x, IsMaxIn R x A := by
  obtain ⟨x, hx⟩ := exists_isMaxIn hR hX hS hA hne
  exact ⟨x, hx, fun y hy => isMaxIn_unique hy hx⟩

/-! ## The rule generated by a mixture -/

section Rule

variable {X : Finset Pt} (hX : (↑X : Set Pt) ⊆ Tri) {n : ℕ} (Rs : Fin n → Rel) (w : Fin n → ℝ)
  (hRS : ∀ i, IsBetweennessPref (Rs i) ∧ StrictOn (Rs i) X) (hw : ∀ i, 0 ≤ w i)
  (hsum : ∑ i, w i = 1)

/-- The random choice rule of the mixture `Σ_i w_i · Rs i`: `p x A = mass w [x is the Rs i-max]`. -/
noncomputable def mixtureRule (hX : (↑X : Set Pt) ⊆ Tri) (Rs : Fin n → Rel) (w : Fin n → ℝ)
    (hRS : ∀ i, IsBetweennessPref (Rs i) ∧ StrictOn (Rs i) X) (hw : ∀ i, 0 ≤ w i)
    (hsum : ∑ i, w i = 1) : RandomChoiceRule X where
  p x A := mass w (fun i => IsMaxIn (Rs i) x A)
  nonneg _ _ _ := mass_nonneg hw _
  zero_of_not_mem A _ x hx := by
    rw [mass_congr w (fun i => show IsMaxIn (Rs i) x A ↔ False from
      ⟨fun h => hx h.1, False.elim⟩)]
    exact mass_false w
  sum_one A hA hne := by
    unfold mass
    rw [Finset.sum_comm, ← hsum]
    refine Finset.sum_congr rfl fun i _ => ?_
    obtain ⟨m, hm⟩ := exists_isMaxIn (hRS i).1 hX (hRS i).2 hA hne
    rw [Finset.sum_eq_single m]
    · exact ite_eq_left hm
    · intro b _ hbm; exact ite_eq_right (fun h => hbm (isMaxIn_unique h hm))
    · intro hmA; exact absurd hm.1 hmA

lemma mixtureRule_p (x : Pt) (A : Finset Pt) :
    (mixtureRule hX Rs w hRS hw hsum).p x A = mass w (fun i => IsMaxIn (Rs i) x A) := rfl

theorem isMixture_mixtureRule {C : Rel → Prop} (hC : ∀ i, C (Rs i)) :
    IsMixture C X (mixtureRule hX Rs w hRS hw hsum) :=
  ⟨n, Rs, w, fun i => ⟨hC i, (hRS i).2⟩, hw, hsum, fun _ _ _ _ _ => rfl⟩

theorem cdDom_mixtureRule : CDDom X (mixtureRule hX Rs w hRS hw hsum) :=
  cdDom_of_mixture _ hRS hX fun _ _ _ _ _ => rfl

theorem bracketing_mixtureRule : Bracketing X (mixtureRule hX Rs w hRS hw hsum) :=
  bracketing_of_mixture _ hRS hw hsum hX fun _ _ _ _ _ => rfl

end Rule

/-! ## Bracketing determines a rule from its pair values -/

section Determines

variable {X : Finset Pt}

/-- Two rules satisfying Bracketing that agree on all pairs agree on all menus. -/
theorem bracketing_determines {ρ₁ ρ₂ : RandomChoiceRule X} (h1 : Bracketing X ρ₁)
    (h2 : Bracketing X ρ₂) (hpair : ∀ x ∈ X, ∀ y ∈ X, x ≠ y → ρ₁.p x {x, y} = ρ₂.p x {x, y}) :
    ∀ A ⊆ X, ∀ x ∈ A, ρ₁.p x A = ρ₂.p x A := by
  intro A hA x hx
  rw [h1 A hA x hx, h2 A hA x hx,
    minOr1_congr (fun b hb => hpair x (hA hx) b (hA (mem_ASW.1 hb).1) (Ne.symm (mem_ASW.1 hb).2.1)),
    minOr1_congr (fun a ha => hpair x (hA hx) a (hA (mem_ANE.1 ha).1) (Ne.symm (mem_ANE.1 ha).2.1))]

/-- A rule agreeing with a mixture on all menus is that mixture. -/
theorem isMixture_of_agree {C : Rel → Prop} {ρ ρ' : RandomChoiceRule X}
    (h : ∀ A ⊆ X, A.Nonempty → ∀ x ∈ A, ρ.p x A = ρ'.p x A) (h' : IsMixture C X ρ') :
    IsMixture C X ρ := by
  obtain ⟨n, Rs, w, h1, h2, h3, h4⟩ := h'
  exact ⟨n, Rs, w, h1, h2, h3, fun A hA hne x hx => (h A hA hne x hx).trans (h4 A hA hne x hx)⟩

lemma pair_sum (ρ : RandomChoiceRule X) {x y : Pt} (hx : x ∈ X) (hy : y ∈ X) (hne : x ≠ y) :
    ρ.p x {x, y} + ρ.p y {x, y} = 1 := by
  have h := ρ.sum_one {x, y} (pair_subset hx hy) (Finset.insert_nonempty _ _)
  rwa [Finset.sum_pair hne] at h

/-- Under CD-dom, the chord values determine all pair values. -/
theorem pair_agree_of_chords (hX : (↑X : Set Pt) ⊆ Tri) {ρ₁ ρ₂ : RandomChoiceRule X}
    (hCD₁ : CDDom X ρ₁) (hCD₂ : CDDom X ρ₂)
    (hch : ∀ a b, IsChord X a b → fChord ρ₁ a b = fChord ρ₂ a b) :
    ∀ x ∈ X, ∀ y ∈ X, x ≠ y → ρ₁.p x {x, y} = ρ₂.p x {x, y} := by
  intro x hx y hy hxy
  rcases tri_cases (hX hx) (hX hy) (Ne.symm hxy) with h | h | h | h
  · have e1 := pair_sum ρ₁ hx hy hxy
    have e2 := pair_sum ρ₂ hx hy hxy
    have e := hch y x ⟨hy, hx, h⟩
    unfold fChord at e
    rw [Finset.pair_comm y x] at e
    linarith
  · exact hch x y ⟨hx, hy, h⟩
  · rw [pair_eq_one_of_strictFOSD ρ₁ hCD₁ hx hy h, pair_eq_one_of_strictFOSD ρ₂ hCD₂ hx hy h]
  · rw [pair_eq_zero_of_dominator ρ₁ hCD₁ hx hy h, pair_eq_zero_of_dominator ρ₂ hCD₂ hx hy h]

end Determines

/-- **Sufficiency engine.** If `ρ` satisfies CD-dom and Bracketing, and its chord values are
those of a finite mixture of preferences of class `C` (betweenness, strict on `X`), then `ρ` is a
mixture from class `C`. The index type `ι` is any finite type. -/
theorem isMixture_of_chords {C : Rel → Prop} {X : Finset Pt} (hX : (↑X : Set Pt) ⊆ Tri)
    (ρ : RandomChoiceRule X) (hCD : CDDom X ρ) (hB : Bracketing X ρ) {ι : Type*} [Fintype ι]
    (Rs : ι → Rel) (w : ι → ℝ) (hC : ∀ i, C (Rs i))
    (hRS : ∀ i, IsBetweennessPref (Rs i) ∧ StrictOn (Rs i) X) (hw : ∀ i, 0 ≤ w i)
    (hsum : ∑ i, w i = 1)
    (hch : ∀ a b, IsChord X a b → fChord ρ a b = mass w (fun i => SPref (Rs i) a b)) :
    IsMixture C X ρ := by
  let e := Fintype.equivFin ι
  let Rs' : Fin (Fintype.card ι) → Rel := fun j => Rs (e.symm j)
  let w' : Fin (Fintype.card ι) → ℝ := fun j => w (e.symm j)
  have hmass : ∀ P : ι → Prop, mass w' (fun j => P (e.symm j)) = mass w P := by
    classical
    intro P; unfold mass; exact Equiv.sum_comp e.symm (fun i => if P i then w i else 0)
  have hRS' : ∀ j, IsBetweennessPref (Rs' j) ∧ StrictOn (Rs' j) X := fun j => hRS _
  have hw' : ∀ j, 0 ≤ w' j := fun j => hw _
  have hsum' : ∑ j, w' j = 1 := by rw [← hsum]; exact Equiv.sum_comp e.symm w
  refine isMixture_of_agree (ρ' := mixtureRule hX Rs' w' hRS' hw' hsum') ?_
    (isMixture_mixtureRule hX Rs' w' hRS' hw' hsum' fun j => hC _)
  intro A hA _ x hx
  refine bracketing_determines hB (bracketing_mixtureRule hX Rs' w' hRS' hw' hsum')
    (pair_agree_of_chords hX hCD (cdDom_mixtureRule hX Rs' w' hRS' hw' hsum') ?_) A hA x hx
  intro a b hab
  rw [hch a b hab]
  unfold fChord
  rw [mixtureRule_p, mass_congr w' fun j => isMaxIn_pair_iff (ne_of_NE hab.2.2)]
  exact (hmass fun i => SPref (Rs i) a b).symm

end REU
